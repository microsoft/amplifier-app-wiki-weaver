// WikiWeaver V4 - init: seed lens.md. Never overwrites an existing lens.md.
//   mode=plain     -> shell writes the default lens (no model)
//   mode=purpose   -> draft (MODEL) from the purpose text in .wiki/init/purpose.md
//   mode=interview -> a human answers three questions (hexagon; needs
//                     --on-human-gate console), then draft (MODEL)
// The CLI scaffolds the directory layout before this graph runs.

digraph WikiWeaverInit {
    graph [
        goal="Seed lens.md for this wiki from the owner's stated purpose, under the six lens headings.",
        params="py, mode",
        default_max_retries=2,
        default_fidelity="truncate",
        model_stylesheet=".strong { llm_provider: anthropic; llm_model: opus; }"
    ]

    start [shape=Mdiamond]
    done  [shape=Msquare]

    init_mode [shape=parallelogram, max_retries=0,
        tool_command="\"$py\" -m wiki_weaver.steps init_mode \"$mode\""]

    default_lens [shape=parallelogram, max_retries=0,
        tool_command="\"$py\" -m wiki_weaver.steps default_lens"]

    interview [shape=hexagon, mode="freeform",
        label="Lens interview",
        prompt="Three questions to seed this wiki's lens. Answer all three in one reply: (1) What is this wiki for? (2) What do you care about in the sources - what should it notice and keep? (3) What kinds of pages do you want (for example people, projects, decisions, topics)?"]

    draft [shape=box, timeout="900s", class="strong", fidelity="truncate",
        prompt="Draft lens.md for a new wiki. The lens is the steering wheel: the brief and the writer read it on every source to decide what matters. Base it on the owner's own words: the purpose text in .wiki/init/purpose.md if that file exists, and any interview answers given above. Write lens.md with exactly these six ## headings, in this order: Purpose, What matters, People, Question shapes, Page types, Owner. State expertise and intent, not procedure: what the wiki is for, what deserves attention and what does not, who the people are, what questions an agent will bring, and which page types to keep (a short bulleted list of type names with one line each). Keep it to the owner's intent; do not invent facts about people. If the owner is not named, write: Unassigned. Write only lens.md."]

    lens_check [shape=parallelogram, max_retries=0,
        tool_command="\"$py\" -m wiki_weaver.steps lens_check"]

    stop [shape=parallelogram, max_retries=0,
        tool_command="echo 'init: lens.md could not be produced; see the run logs' >&2; exit 1"]

    start -> init_mode
    init_mode -> done         [condition="context.tool.last_line=exists && outcome=success", label="lens.md kept as is"]
    init_mode -> default_lens [condition="context.tool.last_line=plain && outcome=success"]
    init_mode -> draft        [condition="context.tool.last_line=purpose && outcome=success"]
    init_mode -> interview    [condition="context.tool.last_line=interview && outcome=success"]
    init_mode -> stop         [condition="outcome=fail"]

    default_lens -> done [condition="outcome=success"]
    default_lens -> stop [condition="outcome=fail"]

    interview -> draft

    draft -> lens_check
    draft -> stop [condition="outcome=fail"]

    lens_check -> done [condition="context.tool.last_line=ok && outcome=success"]
    lens_check -> stop [condition="context.tool.last_line=bad && outcome=success"]
    lens_check -> stop [condition="outcome=fail"]

    stop -> done [condition="outcome=fail", label="loud exit"]
}
