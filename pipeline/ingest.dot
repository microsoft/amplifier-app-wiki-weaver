// WikiWeaver V4 - ingest
// Per source: select -> assemble -> brief (MODEL) -> page_select -> write (MODEL) -> checks
//   checks: pass -> commit | first failure -> write once more with findings | second -> hold
// After the inbox drains: index (MODEL) rewrites index.md and appends log.md.
// The CLI runs this graph in batches (the engine bounds steps per run) until the inbox drains.
// Every inference is a box node. Every parallelogram runs deterministic glue
// (python -m wiki_weaver.steps), never a model.
//
// Run from the corpus directory:
// Parameters reach each step as environment variables (tool_env), never as shell text.
//   dot-runner run ingest.dot --cwd . --param py=<python with wiki_weaver> \
//     --param run_dir=<abs batch dir> --param cap=<sources per batch, 0 = none> --param only=-

digraph WikiWeaverIngest {
    graph [
        goal="Integrate every pending source in _inbox/ into the wiki, guided by lens.md, so that pages accumulate cited, dated synthesis.",
        params="py, run_dir, cap, only",
        default_max_retries=2,
        default_fidelity="truncate",
        model_stylesheet=".strong { llm_provider: anthropic; llm_model: opus; } .large_context { llm_provider: anthropic; llm_model: sonnet; }"
    ]

    start [shape=Mdiamond]
    done  [shape=Msquare]

    select [shape=parallelogram, max_retries=0,
        tool_command="\"$PY\" -m wiki_weaver.steps select", tool_env="py,run_dir,cap,only"]

    assemble [shape=parallelogram, max_retries=0,
        tool_command="\"$PY\" -m wiki_weaver.steps assemble", tool_env="py"]

    brief [shape=box, timeout="900s", class="strong", fidelity="truncate",
        prompt="You write the brief for one source entering a wiki. Read .wiki/work/context.md: the lens (what this wiki is for and what matters to its owner), the standing corrections, and the source itself. Read index.md if it exists: the pages the wiki already has. Write .wiki/work/brief.md covering: what this source is about; what matters in it, judged by the lens; what to watch for when integrating it (commitments and who owns them, positions that changed, disagreements, details that are easy to get wrong); and which pages it should touch and why. Then write .wiki/work/slugs.txt: at most 8 page slugs, one per line, lowercase words joined by hyphens, no .md suffix. Prefer pages already in index.md; propose a new page only where the lens's page types call for one. Leave out the source's own summary page; it is added automatically. If context.md marks this as a CHANGED SOURCE, focus the brief on what changed and what it overturns. A source with nothing worth keeping may list no slugs, but still write the file. Do not create or edit any other file."]

    page_select [shape=parallelogram, max_retries=0,
        tool_command="\"$PY\" -m wiki_weaver.steps page_select", tool_env="py"]

    write [shape=box, timeout="2400s", class="large_context", fidelity="truncate",
        prompt="You are the writer: integrate one source into the wiki. Read .wiki/work/brief.md (what matters here), .wiki/work/context.md (the lens, the standing corrections, the source), and .wiki/work/pages.md (the pages you may write with their current content, and index.md). If .wiki/work/findings.md exists, a previous attempt failed deterministic checks: fix every finding it lists. Write the source summary page named in context.md and update or create the other selected pages. Write ONLY the files listed in pages.md; never touch index.md, log.md, lens.md or anything else. Integrate, never replace: keep what a page already says and weave the new material in; when something changed, say what and give the date; wrap text that is no longer current in a block, <!-- superseded: YYYY-MM-DD --> ... <!-- /superseded -->, and leave it readable. The marker wraps only the text that is no longer true; the replacement goes outside it, as its own entry; the date is the source's date when a position changes in a source, and the ingest date given in context.md when the source file itself was edited. Disagreement contract: when people disagree, record each position and who holds it, keep decided, proposed and still-open distinct, and never turn an exchange into a conclusion the source does not state. Citations: cite specific claims - dates, numbers, names, commitments, positions - with a quote, as [s<id>: \"five or more words copied exactly from that source\"], using the source id given in context.md; orientation and synthesis sentences need no citation. The quote must be an exact substring of the source (no paraphrase, no added or changed punctuation; choose spans of at least five words without double quotes or square brackets). Keep existing citations exactly as they are. If context.md marks a CHANGED SOURCE, a quoted passage that no longer appears in this version is wrapped in a superseded block, never deleted. `## Current state (as of <today>)` is the first section after the title. It is the page's roll-up: a synthesis of where things stand as the page now reads, for a reader who reads nothing else. Replace it in full every pass rather than adding to it. What it covers is set by the lens's page type. Open with one or two lines on what this is. It summarizes; it does not list updates source by source. Every page starts with YAML frontmatter: title; type (one of the lens page types, or source for a summary page); sources (a list of the exact filenames of the sources the page cites); last_updated (YYYY-MM-DD). No duplicate ## headings within a page. Internal links must point to files that exist. The lens decides what matters; follow it and the standing corrections."]

    checks [shape=parallelogram, max_retries=0,
        tool_command="\"$PY\" -m wiki_weaver.steps checks", tool_env="py"]

    commit [shape=parallelogram, max_retries=0,
        tool_command="\"$PY\" -m wiki_weaver.steps commit", tool_env="py,run_dir"]

    hold [shape=parallelogram, max_retries=0,
        tool_command="\"$PY\" -m wiki_weaver.steps hold", tool_env="py,run_dir"]

    index_prep [shape=parallelogram, max_retries=0,
        tool_command="\"$PY\" -m wiki_weaver.steps index_prep", tool_env="py,run_dir"]

    index [shape=box, timeout="1800s", class="strong", fidelity="truncate",
        prompt="Read .wiki/work/index_input.md: what changed in this run, a manifest of every page in the wiki, and the current index.md. Rewrite index.md so it has exactly one line per page in the manifest, in the form - [title](file.md) · date range · one sentence on what the page holds; group the lines under a ## heading per page type. Keep the lines of unchanged pages as they are; read a new or changed page before writing its sentence. Then append to log.md (create it if missing; never edit earlier entries) one dated entry for this run: what was ingested, which pages changed and how, what was held and why. Touch no other file."]

    finalize [shape=parallelogram, max_retries=0,
        tool_command="\"$PY\" -m wiki_weaver.steps finalize", tool_env="py"]

    // Loud terminal: a glue step itself broke (not a source problem). Routes to the
    // single exit with its own nonzero status so the run reports fail, not a routing error.
    // The index step failed: restore index.md and log.md from HEAD (page commits stay)
    // and end the run with a failure.
    index_restore [shape=parallelogram, max_retries=0,
        tool_command="\"$PY\" -m wiki_weaver.steps index_restore", tool_env="py"]

    stop [shape=parallelogram, max_retries=0,
        tool_command="echo 'ingest stopped: a deterministic step failed; see the run logs' >&2; exit 1"]

    // ---------------- per source
    start  -> select
    select -> assemble   [condition="context.tool.last_line=source && outcome=success"]
    select -> index_prep [condition="context.tool.last_line=drained && outcome=success"]
    select -> stop       [condition="outcome=fail"]

    assemble -> brief
    assemble -> hold [condition="outcome=fail"]

    brief -> page_select
    brief -> hold [condition="outcome=fail", label="model step failed"]

    page_select -> write
    page_select -> hold [condition="outcome=fail", label="no usable slugs"]

    write -> checks
    write -> hold [condition="outcome=fail", label="model step failed"]

    checks -> commit [condition="context.tool.last_line=pass && outcome=success"]
    checks -> write  [condition="context.tool.last_line=rewrite && outcome=success", label="once more, with findings"]
    checks -> hold   [condition="context.tool.last_line=hold && outcome=success", label="failed twice"]
    checks -> hold   [condition="outcome=fail"]

    // bounded back-edges: one per source; select drains the inbox (and honors --max-cycles)
    commit -> select [condition="outcome=success", loop_restart="true", label="next source"]
    commit -> stop   [condition="outcome=fail"]
    hold   -> select [condition="outcome=success", loop_restart="true", label="next source"]
    hold   -> stop   [condition="outcome=fail"]

    // ---------------- after the drain
    index_prep -> index    [condition="context.tool.last_line=index && outcome=success"]
    index_prep -> done     [condition="context.tool.last_line=skip && outcome=success"]
    index_prep -> stop     [condition="outcome=fail"]
    index      -> finalize
    index      -> index_restore [condition="outcome=fail", label="index failed; restore index and log"]
    finalize   -> done     [condition="outcome=success"]
    finalize   -> stop     [condition="outcome=fail"]

    index_restore -> done [condition="outcome=fail", label="loud exit: index failed"]
    stop -> done [condition="outcome=fail", label="loud exit"]
}
